# Скопируйте этот файл в .env.local и подставьте значения своего проекта Supabase.
# Обе переменные читаются только на сервере: браузер к Supabase напрямую не обращается.

# Supabase → Project Settings → Data API → Project URL
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase → Project Settings → API Keys → Publishable key (sb_publishable_...)
# Подойдёт и старый anon-ключ. Secret / service_role ключ приложению НЕ нужен — не добавляйте его.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx